      "Bash(git show:*)",
      "Bash(npm run build)",
      "Bash(npm run build:*)",
      "Bash(npm run typecheck)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run type-check)",
      "Bash(npm run type-check:*)",
      "Bash(npm run lint)",
